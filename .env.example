# Target environment — must match framework.config.json "environments"
ENV=qa

# Primary API (service name "api")
BASE_URL=https://jsonplaceholder.typicode.com

# Optional extra services (keys come from framework.config.json "services")
AUTH_BASE_URL=http://127.0.0.1:4010

# none | oauth2_client_credentials | oauth2_password | jwt_login | static_bearer
AUTH_TYPE=oauth2_client_credentials

# Set true only when you need tests-support/auth-server (this sample repo)
START_MOCK_AUTH=true

# Optional JSON merged into every request (Accept: application/json is always set)
DEFAULT_HEADERS=

# TLS
IGNORE_HTTPS_ERRORS=false

# OAuth2 / JWT
OAUTH_TOKEN_URL=http://127.0.0.1:4010/oauth/token
OAUTH_CLIENT_ID=test-client
OAUTH_CLIENT_SECRET=test-secret
OAUTH_USERNAME=admin
OAUTH_PASSWORD=admin-pass
JWT_LOGIN_URL=http://127.0.0.1:4010/auth/login
STATIC_BEARER_TOKEN=

# Per-role overrides: OAUTH_CLIENT_ID_<ROLE>, OAUTH_USERNAME_<ROLE>, etc.
OAUTH_CLIENT_ID_ADMIN=
OAUTH_CLIENT_SECRET_ADMIN=

# Contract testing
CONTRACT_STRICT=false
OPENAPI_SPEC_PATH=specs/openapi.yaml

# Playwright tuning
PW_RETRIES=
PW_WORKERS=
PW_TIMEOUT=
LOG_LEVEL=info
