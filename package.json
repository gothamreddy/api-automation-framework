{
  "name": "api-automation-framework",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "bddgen": "bddgen",
    "test": "node scripts/run-tests.mjs",
    "test:qa": "node scripts/run-tests.mjs --env qa",
    "test:stage": "node scripts/run-tests.mjs --env stage",
    "test:val": "node scripts/run-tests.mjs --env val",
    "test:smoke": "node scripts/run-tests.mjs --tags @smoke",
    "test:regression": "node scripts/run-tests.mjs --tags @regression",
    "test:contract": "node scripts/run-tests.mjs --tags @contract",
    "allure:generate": "allure generate allure-results -o allure-report --clean",
    "allure:open": "allure open allure-report",
    "report": "playwright show-report",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^10.1.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "allure-commandline": "^2.34.0",
    "allure-playwright": "^3.2.0",
    "dotenv": "^16.4.7",
    "jsonwebtoken": "^9.0.2",
    "playwright-bdd": "^9.2.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@playwright/test": "^1.64.1",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.10",
    "eslint": "^9.21.0",
    "openapi-types": "^12.1.3",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0"
  }
}
