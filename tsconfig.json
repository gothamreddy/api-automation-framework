{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src/**/*", "steps/**/*", "tests-support/**/*", "playwright.config.ts", "framework.config.json"],
  "exclude": [".features-gen", "node_modules", "allure-report", "playwright-report"]
}
